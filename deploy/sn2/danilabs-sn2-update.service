[Unit]
Description=Check and verify a DaniLabs SN2 validator update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=danilabs-sn2-deploy
Group=danilabs-sn2
StateDirectory=danilabs-sn2-deploy
StateDirectoryMode=0750
Environment=PYTHONPATH=/opt/danilabs-sn2/control
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GIT_TERMINAL_PROMPT=0
ExecStart=/usr/bin/python3 -m danilabs_validator.updater --config /etc/danilabs-sn2/updater.json --once
TimeoutStartSec=12min
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
